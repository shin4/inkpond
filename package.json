{
  "name": "inkpond",
  "version": "0.1.0",
  "description": "An ink-wash background of Chinese glyphs for the web: hills in mist, a lotus pond with koi, and the Qingming handscroll. Ripples follow the pointer, clicks drop ink.",
  "keywords": [
    "canvas",
    "background",
    "ink-wash",
    "chinese",
    "glyphs",
    "shanshui",
    "qingming",
    "koi",
    "react",
    "animation"
  ],
  "homepage": "https://github.com/shin4/inkpond#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shin4/inkpond.git"
  },
  "bugs": {
    "url": "https://github.com/shin4/inkpond/issues"
  },
  "author": "Shin",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./inkpond.css": "./dist/inkpond.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "build:demo": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@testing-library/react": "16.3.3",
    "@types/node": "25.9.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "29.1.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "4.1.11"
  }
}
